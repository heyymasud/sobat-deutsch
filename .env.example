VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error tracking DSN. Leave empty to disable (Sentry.init no-ops in dev/test).
VITE_SENTRY_DSN=

# Local-dev admin account seed credentials (scripts/seed_admin.mjs).
# NOT VITE_-prefixed on purpose -- must never be bundled into client code.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# scripts/import_to_supabase.py -- target production Postgres. Isi untuk import ke prod,
# kosongkan/hapus untuk balik ke default lokal (127.0.0.1:54322).
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DB=
